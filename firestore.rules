    // ===== 刀房 未交班／交錯班紀錄 =====
    function orAdmin()  { return request.auth != null && request.auth.token.email == 'jane102310@gmail.com'; }
    function orMember() { return request.auth != null && exists(/databases/$(database)/documents/or_members/$(request.auth.token.email)); }
    function orOwner()  { return resource.data.createdBy == request.auth.token.email; }

    match /or_records/{id} {
      allow read: if orMember();
      allow create: if orMember() && (id == '_config_types' || request.resource.data.createdBy == request.auth.token.email);
      allow update: if orMember() && (orAdmin() || id == '_config_types'
                      || (orOwner() && request.resource.data.createdBy == resource.data.createdBy));
      allow delete: if orMember() && (orAdmin() || orOwner());
    }
    match /or_members/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || orAdmin());
      allow write: if orAdmin();
    }
    match /or_requests/{email} {
      allow create, update: if request.auth != null && request.auth.token.email == email;
      allow read: if request.auth != null && (request.auth.token.email == email || orAdmin());
      allow delete: if orAdmin();
    }
