    // ===== 刀房 未交班／交錯班紀錄 =====
    // 團隊共用帳號 orteam@koreabuy.app（團隊密碼）或 or_members 名單裡的 Google 帳號可讀寫
    match /or_records/{id} {
      allow read, write: if request.auth != null
        && (request.auth.token.email == 'orteam@koreabuy.app'
            || exists(/databases/$(database)/documents/or_members/$(request.auth.token.email)));
    }
    match /or_members/{email} {
      allow read: if request.auth != null
        && (request.auth.token.email == email || request.auth.token.email == 'jane102310@gmail.com');
      allow write: if request.auth != null && request.auth.token.email == 'jane102310@gmail.com';
    }
