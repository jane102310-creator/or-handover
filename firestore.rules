    // ===== 刀房 未交班／交錯班紀錄（只有 or_members 名單裡的人能讀寫）=====
    match /or_records/{id} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/or_members/$(request.auth.token.email));
    }
    match /or_members/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
